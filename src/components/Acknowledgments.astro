---
interface Acknowledgment {
  name: string;
  href: string;
}

interface Props {
  items: Acknowledgment[];
}

const { items } = Astro.props;
---

<section id="acknowledgments" class="bg-white py-16 text-nei-text">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <h2 class="text-center text-3xl font-extrabold text-nei-blue-dark md:text-4xl">Agradecimentos</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <a
          href={item.href}
          class="rounded-xl border border-nei-blue/20 bg-nei-blue-soft/50 p-6 text-center text-sm font-semibold text-nei-blue-dark wrap-break-words transition hover:bg-nei-blue-soft"
        >
          {item.name}
        </a>
      ))}
    </div>
  </div>
</section>
