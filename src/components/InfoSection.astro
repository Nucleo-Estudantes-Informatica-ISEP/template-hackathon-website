---
interface InfoItem {
  title: string;
  text: string;
}

interface Props {
  items: InfoItem[];
}

const { items } = Astro.props;
---

<section id="info" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  <h2 class="section-title text-center">Informações</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <article class="card p-6">
        <h3 class="text-lg font-bold text-nei-blue-dark">{item.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-nei-text/90">{item.text}</p>
      </article>
    ))}
  </div>
</section>
