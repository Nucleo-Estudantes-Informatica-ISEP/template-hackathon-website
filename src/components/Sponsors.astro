---
interface Sponsor {
  name: string;
  href: string;
}

interface Props {
  items: Sponsor[];
}

const { items } = Astro.props;
---

<section id="sponsors" class="bg-nei-blue-dark py-16 text-white">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <h2 class="text-center text-3xl font-extrabold md:text-4xl">Sponsors</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <a
          href={item.href}
          class="rounded-xl border border-white/20 bg-white/10 p-6 text-center text-sm font-semibold wrap-break-words hover:bg-white/20"
        >
          {item.name}
        </a>
      ))}
    </div>
  </div>
</section>
